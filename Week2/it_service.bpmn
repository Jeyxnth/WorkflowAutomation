  <bpmn:process id="Process_129h1mt" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Employee reports IT problem">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitRequest" name="Submit IT support request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RegisterRequest" name="Register the request">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckSeverity" name="Check severity of the problem">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Severity" name="Severity level?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssignTechnician" name="Assign to support technician">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignSeniorTechnician" name="Assign to senior technician">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Investigate" name="Technician investigates the problem">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Resolvable" name="Can be resolved internally?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FixProblem" name="Fix the problem">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Escalate" name="Escalate to external service provider">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_UpdateStatus" name="Update request status">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RegisterRequest" targetRef="Task_CheckSeverity" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckSeverity" targetRef="Gateway_Severity" />
    <bpmn:sequenceFlow id="Flow_5" name="Low severity" sourceRef="Gateway_Severity" targetRef="Task_AssignTechnician">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Severrity = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="High severity" sourceRef="Gateway_Severity" targetRef="Task_AssignSeniorTechnician">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Severity = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AssignTechnician" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AssignSeniorTechnician" targetRef="Task_Investigate" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Investigate" targetRef="Gateway_Resolvable" />
    <bpmn:sequenceFlow id="Flow_10" name="Resolvable" sourceRef="Gateway_Resolvable" targetRef="Task_FixProblem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Res = 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Not resolvable" sourceRef="Gateway_Resolvable" targetRef="Task_Escalate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Res = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_FixProblem" targetRef="Task_UpdateStatus" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Escalate" targetRef="Task_UpdateStatus" />
  </bpmn:process>
