      <bpmndi:BPMNShape id="Gateway_Eligible_di" bpmnElement="Gateway_Eligible" isMarkerVisible="true">
        <omgdc:Bounds x="660" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="640" y="71" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardToOfficer_di" bpmnElement="Task_ForwardToOfficer">
        <omgdc:Bounds x="760" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OfficerApproves_di" bpmnElement="Gateway_OfficerApproves" isMarkerVisible="true">
        <omgdc:Bounds x="920" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="916" y="57.5" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DisburseLoan_di" bpmnElement="Task_DisburseLoan">
        <omgdc:Bounds x="1020" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApprovalNotif_di" bpmnElement="Task_SendApprovalNotif">
        <omgdc:Bounds x="1170" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <omgdc:Bounds x="1320" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1298" y="145" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRejectionNotif_di" bpmnElement="Task_SendRejectionNotif">
        <omgdc:Bounds x="1020" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <omgdc:Bounds x="1170" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1148" y="285" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectInvalidDocs_di" bpmnElement="Task_RejectInvalidDocs">
        <omgdc:Bounds x="470" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_InvalidDocs_di" bpmnElement="EndEvent_InvalidDocs">
        <omgdc:Bounds x="632" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="607" y="325" width="87" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyNotEligible_di" bpmnElement="Task_NotifyNotEligible">
        <omgdc:Bounds x="740" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_NotEligible_di" bpmnElement="EndEvent_NotEligible">
        <omgdc:Bounds x="862" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="850" y="335" width="60" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="188" y="120" />
        <omgdi:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="340" y="120" />
        <omgdi:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <omgdi:waypoint x="450" y="120" />
        <omgdi:waypoint x="500" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <omgdi:waypoint x="425" y="145" />
        <omgdi:waypoint x="425" y="300" />
        <omgdi:waypoint x="470" y="300" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="402" y="212" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
