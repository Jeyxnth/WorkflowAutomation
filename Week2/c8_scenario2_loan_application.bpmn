        <omgdi:waypoint x="600" y="120" />
        <omgdi:waypoint x="660" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="570" y="300" />
        <omgdi:waypoint x="632" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eligible_di" bpmnElement="Flow_Eligible">
        <omgdi:waypoint x="710" y="120" />
        <omgdi:waypoint x="760" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotEligible_di" bpmnElement="Flow_NotEligible">
        <omgdi:waypoint x="685" y="145" />
        <omgdi:waypoint x="685" y="230" />
        <omgdi:waypoint x="740" y="230" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="673" y="177" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <omgdi:waypoint x="860" y="120" />
        <omgdi:waypoint x="920" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <omgdi:waypoint x="840" y="230" />
        <omgdi:waypoint x="880" y="230" />
        <omgdi:waypoint x="880" y="292" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OfficerApproves_di" bpmnElement="Flow_OfficerApproves">
        <omgdi:waypoint x="970" y="120" />
        <omgdi:waypoint x="1020" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OfficerRejects_di" bpmnElement="Flow_OfficerRejects">
        <omgdi:waypoint x="945" y="145" />
        <omgdi:waypoint x="945" y="260" />
        <omgdi:waypoint x="1020" y="260" />
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="917" y="184" width="87" height="14" />
        </bpmndi:BPMNLabel>
