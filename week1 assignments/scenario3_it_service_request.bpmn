      <bpmndi:BPMNEdge id="Edge_Flow_LowToInvestigate" bpmnElement="Flow_LowToInvestigate">
        <di:waypoint x="1030" y="120" />
        <di:waypoint x="1125" y="120" />
        <di:waypoint x="1125" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_HighToInvestigate" bpmnElement="Flow_HighToInvestigate">
        <di:waypoint x="1030" y="320" />
        <di:waypoint x="1125" y="320" />
        <di:waypoint x="1125" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ToInvestigate" bpmnElement="Flow_ToInvestigate">
        <di:waypoint x="1150" y="200" />
        <di:waypoint x="1220" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="1350" y="200" />
        <di:waypoint x="1415" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CanResolve" bpmnElement="Flow_CanResolve">
        <di:waypoint x="1440" y="175" />
        <di:waypoint x="1440" y="120" />
        <di:waypoint x="1540" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1465" y="140" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CannotResolve" bpmnElement="Flow_CannotResolve">
        <di:waypoint x="1440" y="225" />
        <di:waypoint x="1440" y="320" />
        <di:waypoint x="1540" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1460" y="265" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_FixToUpdate" bpmnElement="Flow_FixToUpdate">
