      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_LowSeverity" bpmnElement="Flow_LowSeverity">
        <di:waypoint x="810" y="175" />
        <di:waypoint x="810" y="120" />
        <di:waypoint x="900" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825" y="140" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_HighSeverity" bpmnElement="Flow_HighSeverity">
        <di:waypoint x="810" y="225" />
        <di:waypoint x="810" y="320" />
        <di:waypoint x="900" y="320" />
        <bpmndi:BPMNLabel>
