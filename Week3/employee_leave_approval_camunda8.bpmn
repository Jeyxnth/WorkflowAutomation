        <di:waypoint x="1440" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HR_UpdateBalance_di" bpmnElement="Flow_HR_UpdateBalance">
        <di:waypoint x="1390" y="250" />
        <di:waypoint x="1440" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Update_Notify_di" bpmnElement="Flow_Update_Notify">
        <di:waypoint x="1610" y="250" />
        <di:waypoint x="1660" y="250" />
