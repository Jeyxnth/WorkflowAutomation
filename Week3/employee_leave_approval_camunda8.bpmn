        <di:waypoint x="1850" y="250" />
        <di:waypoint x="1900" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
