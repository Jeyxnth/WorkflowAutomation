<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_04blzlk" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_07crtx0" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Customer places order">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckAvailability" name="Check product availability">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Availability" name="Product available?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ProcessPayment" name="Process payment">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyOutOfStock" name="Notify customer: out of stock">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_OutOfStock" name="Order cannot be fulfilled">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment successful?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfirmOrder" name="Confirm order">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyPaymentFailed" name="Notify customer: payment failed">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_PaymentFailed" name="Order not completed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_PrepareShipment" name="Prepare product for shipment">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendShipConfirm" name="Send shipping confirmation to customer">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Success" name="Order completed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckAvailability" targetRef="Gateway_Availability" />
    <bpmn:sequenceFlow id="Flow_3" name="Available" sourceRef="Gateway_Availability" targetRef="Task_ProcessPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Avl=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="Unavailable" sourceRef="Gateway_Availability" targetRef="Task_NotifyOutOfStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Avl = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ProcessPayment" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_NotifyOutOfStock" targetRef="EndEvent_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_7" name="Success" sourceRef="Gateway_Payment" targetRef="Task_ConfirmOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Trans = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" name="Failed" sourceRef="Gateway_Payment" targetRef="Task_NotifyPaymentFailed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Trans = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ConfirmOrder" targetRef="Task_PrepareShipment" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyPaymentFailed" targetRef="EndEvent_PaymentFailed" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ShipOrder" targetRef="Task_SendShipConfirm" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SendShipConfirm" targetRef="EndEvent_Success" />
  </bpmn:process>
